<!-- 自訂規則
     rule id 範圍：100000-109999（不與內建規則衝突）
     修改後需重啟 Manager：docker compose restart wazuh.manager
-->
<group name="local,">

  <!-- ==========================================
       登入相關規則
  ========================================== -->

  <!-- SSH 登入成功：立刻通報 -->
  <rule id="100001" level="8">
    <if_group>authentication_success</if_group>
    <description>登入成功：$(dstuser) 從 $(srcip)</description>
    <group>login_notify</group>
  </rule>

  <!-- SSH 登入失敗：只記錄，不通報 -->
  <rule id="100002" level="5">
    <if_group>authentication_failure</if_group>
    <description>登入失敗：$(dstuser) 從 $(srcip)</description>
    <!-- 不加 login_notify，不會送 Telegram -->
  </rule>

  <!-- 暴力破解：60 秒內失敗 10 次才通報 -->
  <rule id="100003" level="12" frequency="10" timeframe="60">
    <if_matched_sid>100002</if_matched_sid>
    <description>暴力破解警告：60秒內 10 次失敗，來自 $(srcip)</description>
    <group>login_notify</group>
  </rule>

  <!-- 暴力破解後登入成功：最高警戒 -->
  <rule id="100004" level="15">
    <if_matched_sid>100003</if_matched_sid>
    <if_group>authentication_success</if_group>
    <description>【緊急】暴力破解後登入成功！來自 $(srcip)</description>
    <group>login_notify</group>
  </rule>

  <!-- ==========================================
       權限提升
  ========================================== -->

  <!-- sudo 使用：通報 -->
  <rule id="100010" level="8">
    <if_group>sudo</if_group>
    <description>sudo 執行：$(dstuser)</description>
    <group>login_notify</group>
  </rule>

  <!-- 新增系統使用者：通報 -->
  <rule id="100011" level="10">
    <if_group>adduser</if_group>
    <description>系統新增了使用者帳號</description>
    <group>login_notify</group>
  </rule>

  <!-- 使用者被加入 sudo/wheel 群組 -->
  <rule id="100012" level="12">
    <if_group>adduser</if_group>
    <match>sudo|wheel|admin</match>
    <description>使用者被加入高權限群組</description>
    <group>login_notify</group>
  </rule>

  <!-- ==========================================
       檔案完整性（FIM）
  ========================================== -->

  <!-- /etc 底下有檔案被修改 -->
  <rule id="100020" level="10">
    <if_group>syscheck</if_group>
    <match>/etc/</match>
    <description>系統設定檔異動：$(file)</description>
    <group>login_notify</group>
  </rule>

  <!-- 系統執行檔被修改（可疑） -->
  <rule id="100021" level="12">
    <if_group>syscheck</if_group>
    <match>/usr/bin/|/usr/sbin/|/bin/|/sbin/</match>
    <description>【警告】系統執行檔異動：$(file)</description>
    <group>login_notify</group>
  </rule>

  <!-- ==========================================
       高風險事件
  ========================================== -->

  <!-- Rootkit 偵測：只攔截官方 rootcheck 規則中真正告警等級的項目
       （不用 if_group rootcheck，避免抓到掃描開始/結束等狀態訊息） -->
  <rule id="100030" level="15">
    <if_sid>510</if_sid>
    <description>【緊急】Rootkit 或惡意程式偵測：$(title)</description>
    <group>login_notify</group>
  </rule>

</group>
